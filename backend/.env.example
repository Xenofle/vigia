# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto en el que escucha la API
PORT=4000

# Origen permitido por CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Cadena de conexión a PostgreSQL.
# No se usa todavía: se incorpora en el Hito 2, cuando entre el modelo de datos.
DATABASE_URL=postgresql://vigia:vigia@localhost:5432/vigia
